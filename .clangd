# clangd parses with Clang, but everything measured is built with GCC 16. Strip
# the GCC-only flags from compile_commands.json so clangd doesn't report
# "unknown argument" on every file. Contracts and reflection then take their
# fallback paths in the editor, which is intended.
CompileFlags:
  Remove:
    - -fcontract-evaluation-semantic=*
    - -fcontracts*
    - -freflection
---
# Seam headers need exactly one TA_BACKEND_*. A header has no compile command
# of its own, so clangd borrows one from some source file, which may have no
# backend or a different one. Always view them as the plain backend.
If:
  PathMatch: bench/alloc/.*\.hpp
CompileFlags:
  Remove:
    - -DTA_BACKEND_*
  Add:
    - -DTA_BACKEND_PLAIN=1
